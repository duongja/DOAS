# Express API
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/diaries_of_a_soldier

# Comma-separated browser origins allowed to call the API.
# In production, same-origin requests are allowed automatically.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# OpenCode Zen assistant
# Add your key here; it is read only by the server and never sent to the browser.
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# Required when using the OpenCode Go endpoint:
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# OPENCODE_SESSION_ID=diaries-of-a-soldier
# OPENCODE_TIMEOUT_MS=60000
